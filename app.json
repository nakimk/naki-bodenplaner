{
  "expo": {
    "name": "Naki Bodenplaner",
    "slug": "naki-bodenplaner",
    "scheme": "nakibodenplaner",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5f1ea",
    "description": "Traumboden virtuell verlegen: Parkett, Vinyl und Kork direkt im Foto deines Raums ausprobieren.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ch.nakigmbh.bodenplaner",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "de",
        "CFBundleLocalizations": [
          "de"
        ]
      }
    },
    "android": {
      "package": "ch.nakigmbh.bodenplaner",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#8a5a2b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f5f1ea"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Naki Bodenplaner benötigt Zugriff auf deine Fotos, damit du einen neuen Boden in deinem Raumfoto verlegen kannst.",
          "cameraPermission": "Naki Bodenplaner benötigt die Kamera, damit du deinen Raum fotografieren und einen neuen Boden darin verlegen kannst.",
          "microphonePermission": false
        }
      ]
    ]
  }
}